#!/bin/bash

main() {
    cleanup_wwan
    start_adb
}

cleanup_wwan() {
    ip netns add null || true

    max_wait=20
    waited=0
    while [ $waited -lt $max_wait ]; do
        if ip link show wwan7 &>/dev/null; then
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    for i in wwan1 wwan2 wwan3 wwan4 wwan5 wwan6 wwan7; do
        ip link set "$i" netns null
    done

    # this may be required on some boards to initialize the modem
    sleep 2
    if ! ip -4 addr show wwan0 | grep -q "inet "; then
        systemctl restart ModemManager
    fi
}


start_adb() {
    # Ensure USB serial port has proper permissions for ADB
    if [ -e /dev/ttyGS0 ]; then
        echo "Setting permissions for USB serial port /dev/ttyGS0"
        chmod 666 /dev/ttyGS0
    fi
    
    # Start ADB daemon in server mode
    echo "Starting ADB daemon in server mode..."
    if command -v adb >/dev/null 2>&1; then
        # Start adb in server mode
        nohup adb -a >/var/log/adbd.log 2>&1 &
        echo $! > /var/run/adbd.pid
        echo "ADB daemon started with PID: $(cat /var/run/adbd.pid)"
    else
        echo "ADB not found"
    fi
}

main
exit 0
